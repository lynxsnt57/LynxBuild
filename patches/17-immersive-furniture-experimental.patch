diff --git a/CppProject/World/FurnitureBake.cpp b/CppProject/World/FurnitureBake.cpp
new file mode 100644
index 0000000..4cee772
--- /dev/null
+++ b/CppProject/World/FurnitureBake.cpp
@@ -0,0 +1,69 @@
+#include "FurnitureBake.hpp"
+#include <algorithm>
+#include <map>
+#include <memory>
+#include <stdexcept>
+#include <tuple>
+#include <utility>
+namespace ImmersiveFurniture {
+namespace {
+struct Shelf { int y,height,next; };
+struct Page { Atlas image; std::vector<Shelf> shelves; };
+struct Key {
+ int width,height; std::vector<std::uint32_t> pixels;
+ bool operator<(const Key& x) const {return std::tie(width,height,pixels)<std::tie(x.width,x.height,x.pixels);}
+};
+std::pair<int,int> dimensions(const Element& e,const std::string& face) {
+ int x=static_cast<int>(e.to[0]-e.from[0]);
+ int y=static_cast<int>(e.to[1]-e.from[1]);
+ int z=static_cast<int>(e.to[2]-e.from[2]);
+ if(face=="north"||face=="south")return {x,y};
+ if(face=="east"||face=="west")return {z,y};
+ return {x,z};
+}
+const TextureFace* findFace(const Element& e,const char* name,int state) {
+ const TextureFace* fallback=nullptr;
+ for(const auto& f:e.faces) if(f.direction==name) {if(f.state==state)return &f;if(f.state==0)fallback=&f;}
+ return fallback;
+}
+Rect place(const Key& key, std::vector<Page>& pages) {
+ int w=key.width+2,h=key.height+2;int page=-1,x=0,y=0;
+ for(std::size_t i=0;i<pages.size() && page<0;i++) {
+   auto& p=pages[i];
+   for(auto& shelf:p.shelves)if(h<=shelf.height && shelf.next+w<=AtlasSize){page=static_cast<int>(i);x=shelf.next;y=shelf.y;shelf.next+=w;break;}
+   if(page<0){int top=0;for(const auto& s:p.shelves)top+=s.height;if(top+h<=AtlasSize){page=static_cast<int>(i);x=0;y=top;p.shelves.push_back({top,h,w});}}
+ }
+ if(page<0){if(pages.size()>=512)throw std::runtime_error("furniture atlas page limit reached");page=static_cast<int>(pages.size());pages.emplace_back();pages.back().shelves.push_back({0,h,w});}
+ Atlas& dest=pages[page].image;
+ for(int j=-1;j<=key.height;j++)for(int i=-1;i<=key.width;i++){
+   int sx=std::max(0,std::min(key.width-1,i)),sy=std::max(0,std::min(key.height-1,j));
+   dest.pixels[(y+j+1)*AtlasSize+x+i+1]=key.pixels[sy*key.width+sx];
+ }
+ return {page,x+1,y+1,key.width,key.height};
+}
+}
+bool Bake(const Model& model,BakedModel& result,std::string& error){
+ try{
+  BakedModel temp;std::vector<Page> pages;std::map<Key,Rect> cache;
+  static const char* dirs[]={"north","south","east","west","up","down"};
+  for(int state=0;state<2;state++)for(const auto& elem:model.elements){
+   if((elem.mask&(1<<state))==0)continue;
+   if(elem.kind==Element::Kind::Other){temp.ignoredElements++;continue;}
+   BakedElement out;out.source=elem;out.source.faces.clear();
+   if(elem.kind==Element::Kind::Cube)for(const char* dir:dirs){
+    const auto* f=findFace(elem,dir,state);if(!f){temp.missingFaces++;continue;}
+    auto [w,h]=dimensions(elem,dir);
+    if(w<=0 || h<=0 || static_cast<std::size_t>(w)*h!=f->pixels.size())throw std::runtime_error("invalid baked face dimensions");
+    // Downsample only when the face cannot fit a single atlas slot.
+    int ow=std::min(w,AtlasSize-2),oh=std::min(h,AtlasSize-2);Key key{ow,oh,{}};key.pixels.reserve(ow*oh);
+    for(int y=0;y<oh;y++)for(int x=0;x<ow;x++)key.pixels.push_back(f->pixels[static_cast<std::size_t>(y)*h/oh*w+static_cast<std::size_t>(x)*w/ow]);
+    auto it=cache.find(key);if(it==cache.end()){Rect r=place(key,pages);it=cache.emplace(std::move(key),r).first;}
+    out.faces.push_back({dir,it->second});
+   }
+   if(elem.kind==Element::Kind::Sprite || !out.faces.empty())temp.states[state].push_back(std::move(out));
+  }
+  for(auto& page:pages)temp.atlases.push_back(std::move(page.image));
+  result=std::move(temp);error.clear();return true;
+ }catch(const std::exception& ex){error=ex.what();return false;}
+}
+}
diff --git a/CppProject/World/FurnitureBake.hpp b/CppProject/World/FurnitureBake.hpp
new file mode 100644
index 0000000..6cf7eed
--- /dev/null
+++ b/CppProject/World/FurnitureBake.hpp
@@ -0,0 +1,20 @@
+#pragma once
+#include "FurnitureData.hpp"
+#include <array>
+#include <string>
+#include <vector>
+
+namespace ImmersiveFurniture {
+constexpr int AtlasSize=128;
+struct Rect { int atlas=0,x=0,y=0,width=0,height=0; };
+struct Face { std::string direction; Rect rect; };
+struct BakedElement {
+  Element source;
+  std::vector<Face> faces;
+};
+struct Atlas { std::vector<std::uint32_t> pixels; Atlas():pixels(AtlasSize*AtlasSize,0){} };
+struct BakedModel { std::array<std::vector<BakedElement>,2> states; std::vector<Atlas> atlases; int missingFaces=0, ignoredElements=0; };
+// Makes stable fixed-size atlas pages; leaves 1px extruded margins to prevent bleeding.
+// Returns false without modifying result if model exceeds limits.
+bool Bake(const Model& model, BakedModel& result, std::string& error);
+}
diff --git a/CppProject/World/FurnitureCache.cpp b/CppProject/World/FurnitureCache.cpp
new file mode 100644
index 0000000..7cbedc9
--- /dev/null
+++ b/CppProject/World/FurnitureCache.cpp
@@ -0,0 +1,101 @@
+#include "FurnitureCache.hpp"
+#include "FurnitureData.hpp"
+#include "FurnitureBake.hpp"
+#include <QDir>
+#include <QDateTime>
+#include <QFile>
+#include <QFileInfo>
+#include <QImage>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QRegularExpression>
+#include <algorithm>
+
+namespace CppProject {
+namespace {
+QStringList furnitureFiles(const QString& instance) {
+ QStringList out;
+ QDir saves(instance+"/saves");
+ for(const QFileInfo& world:saves.entryInfoList(QDir::Dirs|QDir::NoDotAndDotDot,QDir::Name)) {
+  QDir hashes(world.absoluteFilePath()+"/immersive_furniture/hash");
+  for(const QFileInfo& file:hashes.entryInfoList(QStringList()<<"*.nbt",QDir::Files|QDir::Readable,QDir::Name))
+   if(QRegularExpression("^[a-f0-9]{64}\\.nbt$").match(file.fileName()).hasMatch())out.append(file.absoluteFilePath());
+ }
+ return out;
+}
+bool writeJson(const QString& path,const QJsonObject& object) {
+ QDir().mkpath(QFileInfo(path).absolutePath());QFile file(path);
+ if (!file.open(QIODevice::WriteOnly|QIODevice::Truncate)) return false;
+ QByteArray json = QJsonDocument(object).toJson(QJsonDocument::Compact);
+ return file.write(json) == json.size();
+}
+QJsonArray point(const std::array<float,3>& p){return {p[0],p[1],p[2]};}
+QString textureName(const std::string& s){
+ QString t=QString::fromStdString(s).toLower();
+ if (!t.contains(':')) t="minecraft:"+t;
+ QStringList pieces=t.split(':');
+ if (pieces.size()!=2 || !QRegularExpression("^[a-z0-9_.-]+$").match(pieces[0]).hasMatch() ||
+     !QRegularExpression("^[a-z0-9_./-]+$").match(pieces[1]).hasMatch()) return {};
+ for (const QString& part:pieces[1].split('/')) if(part.isEmpty() || part=="." || part=="..") return {};
+ return pieces[0]=="minecraft" ? pieces[1] : t;
+}
+}
+QByteArray FurnitureSignature(const QString& instance) {
+ QByteArray sig;
+ for(const QString& filename:furnitureFiles(instance)) {QFileInfo f(filename);sig+=filename.toUtf8()+"|"+QByteArray::number(f.size())+"|"+QByteArray::number(f.lastModified().toMSecsSinceEpoch())+"\n";}
+ return sig;
+}
+void PrepareFurniture(const QString& instance,const QString& cache,QJsonArray& blocks,QSet<QString>& textures,QSet<QString>& sprites,QStringList& report) {
+ QSet<QString> seen;
+ for(const QString& path:furnitureFiles(instance)) {
+  QString hash=QFileInfo(path).baseName();if(seen.contains(hash))continue;seen.insert(hash);
+  QFile file(path);if(file.size()>16*1024*1024 || !file.open(QIODevice::ReadOnly)){report<<hash+": could not read";continue;}
+  QByteArray bytes=file.readAll();ImmersiveFurniture::Model model;ImmersiveFurniture::BakedModel baked;std::string error;
+  if(!ImmersiveFurniture::ReadGzip(bytes.constData(),bytes.size(),model,error) || !ImmersiveFurniture::Bake(model,baked,error)){report<<hash+": "+QString::fromStdString(error);continue;}
+  QString ns="mineimator_immersive", id=ns+":"+hash;
+  QString base=cache+"/assets/"+ns;
+  bool good=true;QStringList localTextures;
+  for(int i=0;i<(int)baked.atlases.size();i++){
+   const auto& src=baked.atlases[i];QImage image(128,128,QImage::Format_ARGB32);
+   for(int y=0;y<128;y++)for(int x=0;x<128;x++)image.setPixel(x,y,src.pixels[y*128+x]);
+   QString name="block/"+hash+"_"+QString::number(i), filename=base+"/textures/"+name+".png";
+   QDir().mkpath(QFileInfo(filename).absolutePath());if(!image.save(filename,"PNG")){good=false;break;}localTextures<<ns+":"+name;
+  }
+  if(!good){report<<hash+": cannot save atlas";continue;}
+  QSet<QString> localSprites;
+  for(int state=0;state<2 && good;state++) {
+   QJsonArray elements;QJsonObject textureMap;int n=0;
+   for(const auto& e:baked.states[state]) {
+    QJsonObject item,faceMap;item["from"]=point(e.source.from);item["to"]=point(e.source.to);
+    if(e.source.rotation!=0){QJsonArray origin;for(int j=0;j<3;j++)origin.append((e.source.from[j]+e.source.to[j])/2);QJsonObject rot;rot["origin"]=origin;rot["axis"]=QString(1, QChar(e.source.axis));rot["angle"]=e.source.rotation;item["rotation"]=rot;}
+    if(e.source.emission>0)item["light_emission"]=e.source.emission;
+    for(const auto& f:e.faces){QString key="t"+QString::number(f.rect.atlas);textureMap[key]=localTextures.value(f.rect.atlas);QJsonObject face;face["texture"]="#"+key;face["uv"]=QJsonArray{f.rect.x/8.0,f.rect.y/8.0,(f.rect.x+f.rect.width)/8.0,(f.rect.y+f.rect.height)/8.0};faceMap[QString::fromStdString(f.direction)]=face;}
+    if(e.source.kind==ImmersiveFurniture::Element::Kind::Sprite && !e.source.sprite.item && !e.source.sprite.tiled && e.source.sprite.size>0){
+     QString tex=textureName(e.source.sprite.texture);QString key="s"+QString::number(n);
+     if(tex.isEmpty()) { n++; continue; }
+     textureMap[key]=tex;localSprites.insert(tex);
+     float w=(e.source.to[0]-e.source.from[0])/e.source.sprite.size,h=(e.source.to[1]-e.source.from[1])/e.source.sprite.size;
+     for(int front=0;front<2;front++){bool reverse=bool(front)==e.source.sprite.mirrored;QJsonObject face;face["texture"]="#"+key;face["uv"]=QJsonArray{reverse?w:0.0,0.0,reverse?0.0:w,h};int angle=((e.source.sprite.rotation%360)+360)%360;face["rotation"]=front?angle:(360-angle)%360;
+      unsigned c=e.source.color; face["mineimator_color"]=int(((c>>16)&255) | (c&0xff00) | ((c&255)<<16));
+      faceMap[front?"north":"south"]=face;}
+    }
+    if(!faceMap.isEmpty()){item["faces"]=faceMap;elements.append(item);}n++;
+   }
+   QJsonObject json;json["textures"]=textureMap;json["elements"]=elements;
+   good=writeJson(base+"/models/block/"+hash+"_"+QString::number(state)+".json",json);
+  }
+  if(!good){report<<hash+": cannot save model";continue;}
+  QJsonObject variants;
+  const char* facing[]={"north","east","south","west"};const int rotations[]={0,90,180,270};
+  for(int state=0;state<2;state++)for(int i=0;i<4;i++){
+   QJsonObject v;v["model"]=ns+":block/"+hash+"_"+QString::number(state);v["y"]=rotations[i];
+   variants[QString("active=%1,facing=%2").arg(state?"true":"false",facing[i])]=v;
+  }
+  QJsonObject stateFile;stateFile["variants"]=variants;
+  if(!writeJson(base+"/blockstates/"+hash+".json",stateFile)){report<<hash+": cannot save blockstate";continue;}
+  QJsonObject entry,states;entry["name"]=id;entry["id"]=id;entry["file"]=id;states["active"]=QJsonArray{"false","true"};states["facing"]=QJsonArray{"north","east","south","west"};entry["states"]=states;blocks.append(entry);
+  for(const QString& t:localTextures)textures.insert(t);sprites.unite(localSprites);
+  report<<hash+": "+QString::fromStdString(model.name)+", missing baked faces: "+QString::number(baked.missingFaces)+", ignored elements: "+QString::number(baked.ignoredElements);
+ }
+}
+}
