# Normalize text files to LF in the repository, keep Windows scripts CRLF.
* text=auto

*.md text eol=lf
*.patch text eol=lf
*.py text eol=lf
*.gml text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.yyp text eol=lf
*.yy text eol=lf
*.xml text eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf

# Binaries — never normalize
*.exe binary
*.dll binary
*.lib binary
*.a binary
*.so binary
*.dylib binary
*.pdb binary
*.zip binary
*.png binary
*.jpg binary
*.webp binary
*.ogg binary
*.wav binary
